# ==========================================================
# CONTOH KONFIGURASI HidroKu
# ==========================================================
# Cara pakai:
#   1. Copy file ini menjadi ".env"  ->  cp .env.example .env
#   2. Ubah nilainya sesuai kebutuhan.
#
# File ".env" TIDAK ikut ter-commit ke GitHub (sudah ada di .gitignore),
# jadi aman untuk menyimpan pengaturan pribadi.
# Kalau file ".env" tidak ada, aplikasi tetap jalan pakai nilai default.
# ----------------------------------------------------------

# Alamat host server.
#   0.0.0.0   = bisa diakses dari HP / alat IoT di Wi-Fi yang sama (default)
#   127.0.0.1 = hanya bisa diakses dari komputer ini saja
FLASK_HOST=0.0.0.0

# Port server web. Ubah jika port 5000 sudah dipakai program lain.
FLASK_PORT=5000

# Mode debug: 0 = mati (AMAN, disarankan), 1 = nyala (hanya untuk belajar).
# JANGAN nyalakan debug jika komputer terhubung jaringan publik.
FLASK_DEBUG=0

# Nama file database SQLite.
DB_PATH=hidroponik.db

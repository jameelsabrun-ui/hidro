# ==========================================================
# CONTOH KONFIGURASI HidroKu
# ==========================================================
# Cara pakai:
#   1. Copy file ini menjadi ".env"  ->  cp .env.example .env
#   2. Ubah nilainya sesuai kebutuhan.
#
# File ".env" TIDAK ikut ter-commit ke GitHub (sudah ada di .gitignore),
# jadi aman untuk menyimpan pengaturan pribadi.
# Kalau file ".env" tidak ada, aplikasi tetap jalan pakai nilai default.
# ----------------------------------------------------------

# Alamat host server.
#   0.0.0.0   = bisa diakses dari HP / alat IoT di Wi-Fi yang sama (default)
#   127.0.0.1 = hanya bisa diakses dari komputer ini saja
FLASK_HOST=0.0.0.0

# Port server web. Ubah jika port 5000 sudah dipakai program lain.
FLASK_PORT=5000

# Mode debug: 0 = mati (AMAN, disarankan), 1 = nyala (hanya untuk belajar).
# JANGAN nyalakan debug jika komputer terhubung jaringan publik.
FLASK_DEBUG=0

# Nama file database SQLite.
DB_PATH=hidroponik.db

# ---------- KEAMANAN (Tahap 2) ----------

# Kunci rahasia untuk perangkat IoT.
# - DIISI    -> endpoint POST /api/sensor wajib mengirim header "X-API-Key: <nilai>".
# - DIKOSONG -> proteksi dimatikan (cukup untuk pemakaian di LAN rumah).
# Contoh nilai acak yang panjang, jangan pakai contoh ini di kehidupan nyata:
API_KEY=

# Batas jumlah request data per menit untuk satu alamat IP (anti-spam).
RATE_LIMIT_PER_MINUTE=60

# ---------- NOTIFIKASI TELEGRAM (Tahap 4) ----------

# Token bot Telegram dari @BotFather (contoh: 123456789:AAHxxxxxxxx).
# Kosongkan untuk mematikan fitur notifikasi.
TELEGRAM_BOT_TOKEN=

# Chat ID tujuan notifikasi (bisa dicek lewat bot @userinfobot).
TELEGRAM_CHAT_ID=

# Jeda minimal antar notifikasi untuk masalah yang sama (dalam menit).
NOTIF_COOLDOWN_MINUTES=30
